# --- Database ---
DATABASE_URL=postgresql+psycopg2://ats_user:ats_password@localhost:5432/ats_insight?client_encoding=utf8&options=-c%20lc_messages%3DC
# Overridden automatically when running via the root docker-compose.
#
# For quick local tests without PostgreSQL:
# DATABASE_URL=sqlite:///./ats_insight.db

# --- Auth ---
SECRET_KEY=super-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Files ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- AI Provider: gemini | ollama | none ---
AI_PROVIDER=gemini

# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# If AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Email (SMTP) ---
# Leave SMTP_HOST empty for local dev: verification emails are printed to
# the uvicorn console instead of actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev
SMTP_USE_TLS=true
RESEND_API_KEY=re_ваш_ключ

FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
