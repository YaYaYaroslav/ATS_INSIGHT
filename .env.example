# Скопіюй цей файл у .env і заповни своїми значеннями:
# cp .env.example .env

# --- База даних ---
# Локально (без встановлення PostgreSQL) можна лишити SQLite:
DATABASE_URL=sqlite:///./ats_insight.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ats_insight

# --- Auth ---
SECRET_KEY=super-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Файли ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- AI Provider: gemini | ollama | none ---
AI_PROVIDER=gemini

# Встав свій реальний ключ з https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Якщо AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
